# Copy this file to .env and fill in your keys.
# .env is gitignored — never commit real credentials.

# ─── LLM ──────────────────────────────────────────────────────────────────────
#
# Required — used by Scout, Lineup, and Hype agents via tools/llm.py → ask()
# Get a free key at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Optional — override the default Gemini model (gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# ─── Last.fm ──────────────────────────────────────────────────────────────────
#
# Optional — used by Scout to fetch real artist names by genre.
# Without this key, Scout falls back to a built-in list of real artists,
# so the pipeline always works.
#
# To get a free key (~1 min):
# 1. Create an account at https://www.last.fm/join
# 2. Register an API app at https://www.last.fm/api/account/create
# 3. Paste the API key below — no client secret needed.
LASTFM_API_KEY=
